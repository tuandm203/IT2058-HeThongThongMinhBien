11-26T06:05:04.662249Z","iopub.execute_input":"2026-11-26T06:05:04.662626Z","iopub.status.idle":"2026-11-26T06:05:04.668073Z","shell.execute_reply.started":"2026-11-26T06:05:04.662602Z","shell.execute_reply":"2026-11-26T06:05:04.667367Z"}},"outputs":[],"execution_count":104},{"cell_type":"code","source":"!find '/kaggle/input/datasets/minhtuan11/fetal-echocardiography-first-trimester/Fetal Echocardiography First Trimester/test' -type f | wc -l","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-26T06:05:04.669052Z","iopub.execute_input":"2026-11-26T06:05:04.6694Z","iopub.status.idle":"2026-11-26T06:05:04.888281Z","shell.execute_reply.started":"2026-11-26T06:05:04.669365Z","shell.execute_reply":"2026-11-26T06:05:04.887496Z"}},"outputs":[{"name":"stdout","text":"1380\n","output_type":"stream"}],"execution_count":105},{"cell_type":"markdown","source":"# Model config","metadata":{}},{"cell_type":"markdown","source":"### Exit early","metadata":{}},{"cell_type":"code","source":"import torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torchvision.models import convnext_tiny, ConvNeXt_Tiny_Weights\n\n# =============================================================================\n# 1. MODULE GATING HỌC ĐƯỢC (Difficulty-Aware Gate)\n# Nhận đặc trưng ảnh + Prediction Entropy -> Dự đoán xác suất thoát sớm h_k(x)\n# =============================================================================\nclass DifficultyGate(nn.Module):\n    def __init__(self, in_features):\n        super().__init__()\n        # Đầu vào là [vector đặc trưng, giá trị entropy H(p)] -> in_features + 1\n        self.gate = nn.Sequential(\n            nn.Linear(in_features + 1, 32),\n            nn.GELU(),\n            nn.Linear(32, 1),\n            nn.Sigmoid() # Trả về xác suất thoát h_k trong khoảng (0, 1)\n        )\n\n    def forward(self, feat, logits):\n        # Tính Prediction Entropy H(p(y|x)) theo công thức bài báo\n        probs = F.softmax(logits.detach(), dim=-1)\n        entropy = -torch.sum(probs * torch.log(probs + 1e-8), dim=-1, keepdim=True)\n        \n        # Nối đặc trưng hình thái (morphology) với entropy\n        gate_input = torch.cat([feat, entropy], dim=-1)\n        halt_prob = self.gate(gate_input) # Shape: [B, 1]\n        return halt_prob\n\n\n# =============================================================================\n# 2. EXIT HEAD CẢI TIẾN (Trả về Logits + Feature đã chiếu sang 768 để làm Feature KD)\n# =============================================================================\nclass ExitHead(nn.Module):\n    def __init__(self, in_channels, hidden_channels=64, num_classes=5, dropout_p=0.3, teacher_dim=768):\n        super().__init__()\n        self.conv = nn.Sequential(\n            nn.Conv2d(in_channels, hidden_channels, kernel_size=1, bias=False),\n            nn.BatchNorm2d(hidden_channels),\n            nn.GELU()\n        )\n        self.pool = nn.AdaptiveAvgPool2d(1)\n        self.dropout = nn.Dropout(p=dropout_p)\n        self.fc = nn.Linear(hidden_channels, num_classes)\n        \n        # Lớp chiếu nhẹ để đồng bộ số chiều với Exit 3 (768) khi tính L_KD^feature\n        self.feat_proj = nn.Linear(hidden_channels, teacher_dim)\n\n    def forward(self, x):\n        x = self.conv(x)\n        feat = self.pool(x).flatten(1)       # [B, hidden_channels]\n        logits = self.fc(self.dropout(feat)) # [B, num_classes]\n        feat_768 = self.feat_proj(feat)      # [B, 768] để so với Exit 3\n        return logits, feat, feat_768","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-26T06:05:04.889823Z","iopub.execute_input":"2026-11-26T06:05:04.890206Z","iopub.status.idle":"2026-11-26T06:05:04.901272Z","shell.execute_reply.started":"2026-11-26T06:05:04.890173Z","shell.execute_reply":"2026-11-26T06:05:04.900448Z"}},"outputs":[],"execution_count":106},{"cell_type":"markdown","source":"### Multi Exit Convnext","metadata":{}},{"cell_type":"code","source":"# =============================================================================\n# 3. MÔ HÌNH DYNAMIC MULTI-EXIT CONVNEXT \n# =============================================================================\nclass MultiExitConvNeXt(nn.Module):\n    def __init__(self, num_classes=5, dropout_p=0.3):\n        super().__init__()\n        \n        backbone = convnext_tiny(weights=ConvNeXt_Tiny_Weights.DEFAULT)\n        features = backbone.features\n\n        # 1. Rã mô hình thành 3 khúc hợp lý để tách rõ Latency (T1 << T2 << T3)\n        self.part1 = features[:4]                       # Hết Stage 2 (192 ch)\n        self.part2_a = nn.Sequential(\n            features[4],                                # Downsample sang Stage 3\n            features[5][:4]                             # Chỉ lấy 4/9 block đầu của Stage 3\n        )\n        self.part2_b = features[5][4:]                  # 5/9 block sau của Stage 3\n        self.part3 = features[6:8]                      # Stage 4 (768 ch)\n\n        # 2. Lắp các Exit Heads\n        self.exit1 = ExitHead(192, hidden_channels=64, num_classes=num_classes, dropout_p=dropout_p)\n        self.exit2 = ExitHead(384, hidden_channels=64, num_classes=num_classes, dropout_p=dropout_p)\n\n        # Exit 3 (Main Head) giữ nguyên 768 chiều để bảo toàn Recall cho X sign\n        self.avgpool = backbone.avgpool\n        self.exit3_norm = nn.Sequential(\n            backbone.classifier[0],                     # LayerNorm2d\n            backbone.classifier[1]                      # Flatten -> [B, 768]\n        )\n        self.exit3_fc = nn.Sequential(\n            nn.Dropout(p=dropout_p),\n            nn.Linear(768, num_classes)\n        )\n\n        # 3. Lắp Learnable Gates cho Exit 1 và Exit 2\n        self.gate1 = DifficultyGate(in_features=64)\n        self.gate2 = DifficultyGate(in_features=64)\n\n    def forward(self, x):\n        # --- EXIT 1 ---\n        x = self.part1(x)\n        y1, f1_raw, f1_proj = self.exit1(x)\n        h1 = self.gate1(f1_raw, y1) # Xác suất muốn thoát ở Exit 1\n\n        # --- EXIT 2 ---\n        x = self.part2_a(x)\n        y2, f2_raw, f2_proj = self.exit2(x)\n        h2 = self.gate2(f2_raw, y2) # Xác suất muốn thoát ở Exit 2 (nếu chưa thoát ở 1)\n\n        # --- EXIT 3 (Final) ---\n        x = self.part2_b(x)\n        x = self.part3(x)\n        x = self.avgpool(x)\n        f3 = self.exit3_norm(x)     # [B, 768] - Dùng làm feature chuẩn cho Feature KD\n        y3 = self.exit3_fc(f3)\n\n        # Tính xác suất chọn từng Exit p_k(x) sao cho p1 + p2 + p3 = 1 (khả vi)\n        p1 = h1\n        p2 = (1.0 - h1) * h2\n        p3 = (1.0 - h1) * (1.0 - h2)\n        exit_probs = torch.cat([p1, p2, p3], dim=-1) # Shape: [B, 3]\n\n        return {\n            \"logits\": (y1, y2, y3),\n            \"features\": (f1_proj, f2_proj, f3),\n            \"exit_probs\": exit_probs\n        }","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-26T06:05:04.902558Z","iopub.execute_input":"2026-11-26T06:05:04.902932Z","iopub.status.idle":"2026-11-26T06:05:04.920042Z","shell.execute_reply.started":"2026-11-26T06:05:04.902905Z","shell.execute_reply":"2026-11-26T06:05:04.919267Z"}},"outputs":[],"execution_count":107},{"cell_type":"code","source":"# import torch.nn as nn\n# from torchvision.models import convnext_tiny, ConvNeXt_Tiny_Weights\n\n# # =============================================================================\n# # MÔ HÌNH MULTI-EXIT CONVNEXT GỐC (Đã cập nhật Bottleneck cho Exit 3)\n# # =============================================================================\n# class MultiExitConvNeXt(nn.Module):\n#     def __init__(self, num_classes=5, dropout_p=0.3):\n#         super().__init__()\n        \n#         # 1. Tải mô hình ConvNeXt-Tiny pre-trained\n#         backbone = convnext_tiny(weights=ConvNeXt_Tiny_Weights.DEFAULT)\n#         features = backbone.features\n\n#         # 2. Rã mô hình thành 3 khúc (Slicing)\n#         self.part1 = features[:4]   # Hết Stage 2 (in_channels=192)\n#         s