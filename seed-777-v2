 as F\n\nclass MultiExit_SelfKDLoss(nn.Module):\n    def __init__(self, base_criterion, T=3.0, max_lambda_kd=0.5, weights=(0.2, 0.3, 1.0)):\n        super().__init__()\n        self.base_criterion = base_criterion\n        self.T = T\n        # Thay đổi: Khởi tạo lambda_kd = 0 ở epoch đầu\n        self.max_lambda_kd = max_lambda_kd\n        self.current_lambda_kd = 0.0 \n        self.w1, self.w2, self.w3 = weights\n        self.kl_div = nn.KLDivLoss(reduction='batchmean')\n\n    def update_lambda_kd(self, epoch, total_epochs, warmup_epochs=5):\n        \"\"\"\n        Hàm cập nhật trọng số KD theo cơ chế Linear Annealing.\n        Gọi hàm này ở đầu mỗi epoch trong training loop.\n        \"\"\"\n        if epoch < warmup_epochs:\n            self.current_lambda_kd = 0.0\n        else:\n            # Tăng dần từ 0 đến max_lambda_kd\n            ratio = (epoch - warmup_epochs) / (total_epochs - warmup_epochs)\n            self.current_lambda_kd = self.max_lambda_kd * ratio\n            \n    def forward(self, outputs, targets):\n        y1, y2, y3 = outputs\n\n        # 1. LOSS EXIT 3 (Nhánh Thầy) - Luôn chiếm trọng số w3 = 1.0\n        loss3 = self.base_criterion(y3, targets)\n\n        # 2. Tạo Soft Labels từ Thầy (CHẶN GRADIENT)\n        soft_teacher = F.softmax(y3 / self.T, dim=1).detach()\n\n        # 3. LOSS EXIT 1 (Nhánh Trò 1)\n        loss1_hard = self.base_criterion(y1, targets)\n        log_soft_y1 = F.log_softmax(y1 / self.T, dim=1)\n        loss1_kd = self.kl_div(log_soft_y1, soft_teacher) * (self.T ** 2)\n        loss1 = loss1_hard + (self.current_lambda_kd * loss1_kd)\n\n        # 4. LOSS EXIT 2 (Nhánh Trò 2)\n        loss2_hard = self.base_criterion(y2, targets)\n        log_soft_y2 = F.log_softmax(y2 / self.T, dim=1)\n        loss2_kd = self.kl_div(log_soft_y2, soft_teacher) * (self.T ** 2)\n        loss2 = loss2_hard + (self.current_lambda_kd * loss2_kd)\n\n        # 5. TỔNG LOSS\n        total_loss = (self.w1 * loss1) + (self.w2 * loss2) + (self.w3 * loss3)\n\n        return total_loss, loss1.item(), loss2.item(), loss3.item()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-26T06:05:04.941135Z","iopub.execute_input":"2026-11-26T06:05:04.94153Z","iopub.status.idle":"2026-11-26T06:05:04.959575Z","shell.execute_reply.started":"2026-11-26T06:05:04.94148Z","shell.execute_reply":"2026-11-26T06:05:04.95897Z"}},"outputs":[],"execution_count":109},{"cell_type":"code","source":"### Multi Exit Convnext DRAS","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-26T06:05:04.962578Z","iopub.execute_input":"2026-11-26T06:05:04.962984Z","iopub.status.idle":"2026-11-26T06:05:04.982474Z","shell.execute_reply.started":"2026-11-26T06:05:04.962957Z","shell.execute_reply":"2026-11-26T06:05:04.981596Z"}},"outputs":[],"execution_count":110},{"cell_type":"code","source":"# import torch\n# import torch._utils\n\n# # Ép gán thuộc tính _utils vào torch để tránh lỗi AttributeError\n# setattr(torch, '_utils', torch._utils)\n\n# import torch.nn as nn\n# from torchvision.models import convnext_tiny, ConvNeXt_Tiny_Weights\n\n# # =============================================================================\n# # 1. MODULE DUAL-REGION ARTIFACT SUPPRESSION (DRAS) - ĐÃ SỬA GROUPNORM\n# # =============================================================================\n# class DRASModule(nn.Module):\n#     def __init__(self, in_channels, reduction=16, use_prior=True):\n#         super().__init__()\n#         self.use_prior = use_prior\n#         hidden_dim = in_channels // reduction  # 192//16 = 12 kênh, 384//16 = 24 kênh\n        \n#         # Spatial Attention Gate\n#         self.spatial_gate = nn.Sequential(\n#             nn.Conv2d(in_channels, hidden_dim, kernel_size=1),\n#             nn.GroupNorm(4, hidden_dim),  # 🎯 Đã sửa từ 8 -> 4 (12 và 24 đều chia hết cho 4)\n#             nn.GELU(),\n#             nn.Conv2d(hidden_dim, 1, kernel_size=3, padding=1),\n#             nn.Sigmoid()\n#         )\n\n#     de