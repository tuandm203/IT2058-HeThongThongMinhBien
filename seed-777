eed(worker_seed)\n\n\ndef get_dataloaders(train_df, val_df, test_df, seed, batch_size=32, num_workers=2):\n    g = torch.Generator()\n    g.manual_seed(seed)\n\n    train_loader = DataLoader(\n        # Truyền is_training=True cho tập Train\n        UltrasoundDataset(train_df, transform_pipeline, is_training=True), \n        batch_size=batch_size, \n        shuffle=True, \n        num_workers=num_workers,\n        worker_init_fn=seed_worker,  \n        generator=g\n    )\n\n    val_loader = DataLoader(\n        # Truyền is_training=False cho tập Val\n        UltrasoundDataset(val_df, transform_pipeline, is_training=False), \n        batch_size=batch_size, \n        shuffle=False, \n        num_workers=num_workers\n    )\n\n    test_loader = DataLoader(\n        # Truyền is_training=False cho tập Test\n        UltrasoundDataset(test_df, transform_pipeline, is_training=False), \n        batch_size=batch_size, \n        shuffle=False, \n        num_workers=num_workers\n    )\n\n    return train_loader, val_loader, test_loader","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T04:42:06.466408Z","iopub.execute_input":"2026-11-24T04:42:06.467671Z","iopub.status.idle":"2026-11-24T04:42:06.477191Z","shell.execute_reply.started":"2026-11-24T04:42:06.467645Z","shell.execute_reply":"2026-11-24T04:42:06.476427Z"}},"outputs":[],"execution_count":18},{"cell_type":"markdown","source":"### Focal Loss & Class Weights  ","metadata":{}},{"cell_type":"code","source":"# ==========================================\n# FOCAL LOSS & CLASS WEIGHTS\n# ==========================================\nclass FocalLoss(nn.Module):\n    def __init__(self, alpha=None, gamma=2):\n        super(FocalLoss, self).__init__()\n        self.alpha = alpha\n        self.gamma = gamma\n\n    def forward(self, inputs, targets):\n        ce_loss = F.cross_entropy(inputs, targets, reduction='none', weight=self.alpha)\n        pt = torch.exp(-ce_loss)\n        focal_loss = ((1 - pt) ** self.gamma) * ce_loss\n        return focal_loss.mean()\n\nclass_weights = compute_class_weight(\n    class_weight='balanced',\n    classes=np.unique(train_df['label_idx']),\n    y=train_df['label_idx'].values\n)\nalpha = torch.tensor(class_weights, dtype=torch.float)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T04:42:06.478442Z","iopub.execute_input":"2026-11-24T04:42:06.478817Z","iopub.status.idle":"2026-11-24T04:42:06.507782Z","shell.execute_reply.started":"2026-11-24T04:42:06.478783Z","shell.execute_reply":"2026-11-24T04:42:06.506833Z"}},"outputs":[],"execution_count":19},{"cell_type":"markdown","source":"### Khởi tạo mô hình & Tính toán khối lượng","metadata":{}},{"cell_type":"code","source":"import torch\nfrom torchinfo import summary  \n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f\"Đang chạy trên thiết bị: {device}\\n\")\n\n# Khởi tạo mô hình MultiExitConvNeXt\nnum_classes = 5\nmodel = MultiExitConvNeXt(num_classes=num_classes)\nmodel = model.to(device)\n\nprint(\"\\n--- BẢNG CẤU TRÚC VÀ KHỐI LƯỢNG TÍNH TOÁN CỦA MÔ HÌNH ---\")\n\n# 👉 BẮT BUỘC BỌC print() VÀ TRUYỀN ĐÚNG INPUT SHAPE\nprint(\n    summary(\n        model, \n        input_size=(32, 3, 224, 224),\n        col_names=[\"input_size\", \"output_size\", \"num_params\", \"params_percent\", \"kernel_size\", \"mult_adds\"],\n        row_settings=[\"var_names\"]\n    )\n)\n\nprint(\"-\" * 60 + \"\\n\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T04:42:06.508874Z","iopub.execute_input":"2026-11-24T04:42:06.509513Z","iopub.status.idle":"2026-11-24T04:42:08.879854Z","shell.execute_reply.started":"2026-11-24T04:42:06.509487Z","shell.execute_reply":"2026-11-24T04:42:08.879005Z"}},"outputs":[{"name":"stdout","text":"Đang chạy trên thiết bị: cuda\n\n\n--- BẢNG CẤU TRÚC VÀ KHỐI LƯỢNG TÍNH TOÁN CỦA MÔ HÌNH ---\n=============================================================================================================================